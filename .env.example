# FocusTrack — Environment Configuration Template
# Copy this file to '.env' and modify values depending on your run environment.
# NEVER commit your active '.env' file to version control.

# =============================================================================
# METHOD 1: Development Configuration
# =============================================================================
# DATABASE_HOST=mysql
# DATABASE_USER=root
# DATABASE_PASSWORD=root
# DATABASE_NAME=AISPT
# MYSQL_ROOT_PASSWORD=root
# MYSQL_DATABASE=AISPT
# FLASK_ENV=development
# SECRET_KEY=dev_secret_key_change_me_later

# =============================================================================
# METHOD 2: Production Configuration (Recommended for Hosting)
# =============================================================================

# ── Database Options ──────────────────────────────────────────────────────────
# Set DATABASE_HOST to 'mysql' if running inside the Docker network.
DATABASE_HOST=mysql
DATABASE_USER=root
DATABASE_PASSWORD=CHANGE_ME_TO_A_VERY_STRONG_PASSWORD
DATABASE_NAME=AISPT

# Root password utilized by the mysql Docker container service.
# This MUST match the value of DATABASE_PASSWORD above.
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_VERY_STRONG_PASSWORD
MYSQL_DATABASE=AISPT

# ── Flask Options ─────────────────────────────────────────────────────────────
# Set to 'production' to disable debugging panel tracebacks.
# Set to 'development' for local debugger support.
FLASK_ENV=production

# Secret key used for signing session cookies. Generate a strong key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY