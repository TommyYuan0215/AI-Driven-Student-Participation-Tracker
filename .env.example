# Template — Copy this file to .env and fill in real values before deploying.
# NEVER commit the actual .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_HOST=mysql
DATABASE_USER=root
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_NAME=AISPT

# MySQL root password (used by the mysql Docker service)
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_DATABASE=AISPT

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production

# Secret key for Flask session signing — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY