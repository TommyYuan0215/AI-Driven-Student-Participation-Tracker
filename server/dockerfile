# Use Python base image
FROM python:3.11-slim

# Set the working directory
WORKDIR /app

# Install system dependencies for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Force CPU-only inference (no GPU required on web server)
ENV CUDA_VISIBLE_DEVICES=-1
ENV TF_FORCE_GPU_ALLOW_GROWTH=false
ENV TF_CPP_MIN_LOG_LEVEL=2

# Set Flask to production mode
ENV FLASK_APP=server.py
ENV FLASK_RUN_HOST=0.0.0.0
ENV FLASK_ENV=production

# Copy only requirements first (to leverage Docker layer caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (source is baked into the image — no bind mounts in prod)
COPY . .

# Expose the Flask/Gunicorn port
EXPOSE 5555

# Production Gunicorn command:
#   -k eventlet      → async worker class required for Socket.IO
#   -w 1             → single worker (eventlet is single-threaded async)
#   --threads 4      → thread pool within the worker
#   --timeout 120    → kill requests that hang more than 2 minutes
#   --log-level warning → suppress info/debug noise in production logs
# NOTE: --reload is intentionally REMOVED (dev-only flag)
CMD ["gunicorn", "-k", "eventlet", "-w", "1", "--threads", "4", "-b", "0.0.0.0:5555", "--timeout", "120", "--log-level", "warning", "server:app"]