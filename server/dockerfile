# =============================================================================
# Stage 1: Build — compile C-extensions and install Python dependencies
# =============================================================================
FROM python:3.10-slim AS builder

WORKDIR /app

# Install system dependencies needed to compile C-extensions (like insightface)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create a virtual environment to copy compiled modules easily
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# =============================================================================
# Stage 2: Production — serve the application with a clean, compiler-free image
# =============================================================================
FROM python:3.10-slim AS production

WORKDIR /app

# Install only runtime system dependencies for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy the compiled virtual environment from the builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Force CPU-only inference (no GPU required on web server)
ENV CUDA_VISIBLE_DEVICES=-1
ENV TF_FORCE_GPU_ALLOW_GROWTH=false
ENV TF_CPP_MIN_LOG_LEVEL=2

# Set Flask to production mode
ENV FLASK_APP=server.py
ENV FLASK_RUN_HOST=0.0.0.0
ENV FLASK_ENV=production

# Copy application source code
COPY . .

# Expose the Flask/Gunicorn port
EXPOSE 5555

# Run the Flask app with optimized Gunicorn settings
CMD ["gunicorn", "-k", "eventlet", "-w", "1", "--threads", "4", "-b", "0.0.0.0:5555", "--timeout", "120", "--log-level", "warning", "server:app"]