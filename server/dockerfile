# Use Python base image
FROM python:3.10.12

# Set the working directory
WORKDIR /app

# Install system dependencies for OpenCV
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables to force CPU usage
ENV CUDA_VISIBLE_DEVICES=-1
ENV TF_FORCE_GPU_ALLOW_GROWTH=false
ENV TF_CPP_MIN_LOG_LEVEL=2

# Copy only requirements first (to leverage Docker caching)
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Now copy the rest of the app code
COPY . .

# Expose Flask's default port
EXPOSE 5555

# Set environment variables for Flask
ENV FLASK_APP=server.py
ENV FLASK_RUN_HOST=0.0.0.0
ENV FLASK_ENV=development 
ENV DB_MODE=local

# Run the Flask app with optimized settings for CPU
CMD ["gunicorn", "-k", "eventlet", "-w", "1", "-b", "0.0.0.0:5555", "--timeout", "120", "--reload", "server:app"]