# =============================================================================
# Stage 1: Base — Set up workspace and install dependencies
# =============================================================================
FROM node:22-alpine AS base
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install
COPY . .

# =============================================================================
# Stage 2: Development — Run Vite development server with hot-reload
# =============================================================================
FROM base AS development
ENV NODE_ENV=development
ENV CHOKIDAR_USEPOLLING=true
EXPOSE 5180
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# =============================================================================
# Stage 3: Builder — Compile the production React build
# =============================================================================
FROM base AS builder
RUN npm run build

# =============================================================================
# Stage 4: Production — Serve compiled React build using Nginx
# =============================================================================
FROM nginx:alpine AS production
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]