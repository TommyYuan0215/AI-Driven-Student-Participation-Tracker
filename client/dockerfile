# =============================================================================
# Stage 1: Build — install deps and compile the React app
# =============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests first (leverages Docker layer caching)
COPY package*.json ./

# Install all dependencies (including devDependencies needed for vite build)
RUN npm ci

# Copy the rest of the source code
COPY . .

# Build the production-optimised static bundle
RUN npm run build

# =============================================================================
# Stage 2: Serve — copy the build output into a lean Nginx image
# =============================================================================
FROM nginx:alpine AS production

# Copy the compiled React app into Nginx's default web root
COPY --from=builder /app/dist /usr/share/nginx/html

# Replace the default Nginx config with our production config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Nginx listens on port 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]